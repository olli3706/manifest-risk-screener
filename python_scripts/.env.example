# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Anthropic (Claude) API — shell-company web search + risk synthesis ------
# ⚠️ When set, manifest/party data is sent to api.anthropic.com (outside your network)
# and Claude runs live web searches. Leave the key blank to run the
# deterministic checks only. Rotate the key if it is ever exposed.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
# Set to 0/false to hard-disable AI even when a key is present.
MRS_AI_ENABLED=1

# Optional screening thresholds (defaults shown):
# MRS_RECENT_DAYS=30
# MRS_VOLUME_SPIKE_FACTOR=2.0
